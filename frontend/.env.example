# Frontend environment variables — copy to .env.local
# Backend API base URL. Leave EMPTY in development to use the Vite proxy (see vite.config.ts),
# which forwards /api -> http://localhost:8080. For production, set the absolute backend URL.
VITE_API_BASE_URL=

# Google Maps API key (for the passenger live tracking map).
# Without this, the map falls back to an OpenStreetMap iframe (no key required).
# Get a key at: https://developers.google.com/maps/documentation/javascript/get-api-key
VITE_GOOGLE_MAPS_API_KEY=

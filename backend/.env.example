# Backend environment variables — copy values into your shell / IDE run configuration.
# (Spring Boot does not auto-load .env files; these are a reference of required config.)

# Database (PostgreSQL + PostGIS)
TP_DB_HOST=localhost
TP_DB_PORT=5432
TP_DB_NAME=tegaprive
TP_DB_USERNAME=postgres
TP_DB_PASSWORD=postgres

# JWT — use a strong random secret in production (minimum 32 bytes)
TP_JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
TP_JWT_ACCESS_EXPIRATION_MIN=30
TP_JWT_REFRESH_EXPIRATION_DAYS=7

# Bootstrap super-admin — created on first startup only if set
TP_DEFAULT_ADMIN_EMAIL=admin@tegaprive.rw
TP_DEFAULT_ADMIN_PASSWORD=ChangeMeStrong123!

# MTN Mobile Money (Sandbox: https://momodeveloper.mtn.com)
TP_MTN_API_BASE_URL=https://sandbox.momodeveloper.mtn.com
TP_MTN_SUBSCRIPTION_KEY=
TP_MTN_API_USER=
TP_MTN_API_KEY=
TP_MTN_CALLBACK_HOST=https://your-public-api-url.com
TP_MTN_TARGET_ENVIRONMENT=sandbox

# Airtel Money (Sandbox: https://developers.airtel.africa)
TP_AIRTEL_API_BASE_URL=https://openapiuat.airtel.africa
TP_AIRTEL_CLIENT_ID=
TP_AIRTEL_CLIENT_SECRET=
TP_AIRTEL_CALLBACK_HOST=https://your-public-api-url.com

# Dev payment bypass (true = /api/payments/{id}/dev-confirm works without real webhook)
TP_PAYMENT_DEV_BYPASS=true

# CORS
TP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
TP_SERVER_PORT=8080

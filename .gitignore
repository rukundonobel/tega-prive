# ===== TEGA PRIVÉ root .gitignore =====

# ----- Secrets / env -----
.env
.env.*
!.env.example
*.pem
*.key
firebase-service-account*.json

# ----- Java / Maven (backend) -----
backend/target/
backend/build/
backend/.mvn/wrapper/maven-wrapper.jar
backend/dependency-reduced-pom.xml
*.class
*.jar
*.war
hs_err_pid*.log
replay_pid*.log

# ----- Node / Vite (frontend) -----
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local
frontend/.env.local
frontend/.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- IDE / Editor -----
.idea/
*.iml
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Logs / temp -----
*.log
tmp/
temp/
